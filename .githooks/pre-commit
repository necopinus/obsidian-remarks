#!/usr/bin/env bash
#
# obsidian-remarks pre-commit hook
#
# Runs linters/formatters on staged files. Excludes:
#   - .obsidian/plugins/** (third-party plugin data)
#   - .build/quartz/**    (Quartz checkout — regenerated each build)
#
# Requires: shellcheck, shfmt, yamllint, markdownlint-cli2, betterleaks.
#
# Set REMARKS_PRE_COMMIT_SKIP_MISSING=1 to warn-and-continue when a
# tool is unavailable; the default is to fail.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- helpers --------------------------------------------------------------

log() { printf '\033[1;34m[pre-commit]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[pre-commit][warn]\033[0m %s\n' "$*" >&2; }
fail() {
  printf '\033[1;31m[pre-commit][fail]\033[0m %s\n' "$*" >&2
  exit 1
}

require_tool() {
  local tool="$1"
  if ! command -v "$tool" >/dev/null 2>&1; then
    if [[ "${REMARKS_PRE_COMMIT_SKIP_MISSING:-0}" == "1" ]]; then
      warn "$tool not found in PATH; skipping $2 checks"
      return 1
    fi
    fail "$tool not found in PATH; install it or set REMARKS_PRE_COMMIT_SKIP_MISSING=1"
  fi
  return 0
}

# --- collect staged files -------------------------------------------------

mapfile -t STAGED < <(
  git diff --cached --name-only --diff-filter=ACMR
)

if [[ ${#STAGED[@]} -eq 0 ]]; then
  log "no staged files; nothing to check"
  exit 0
fi

# --- filter to file types and exclude third-party paths -------------------

EXCLUDE_RES=(
  '^\.obsidian/plugins/'
  '^\.build/quartz/'
)

is_excluded() {
  local f="$1"
  local rx
  for rx in "${EXCLUDE_RES[@]}"; do
    [[ "$f" =~ $rx ]] && return 0
  done
  return 1
}

SH_FILES=()
YAML_FILES=()
MD_FILES=()
ALL_FILES=()

for f in "${STAGED[@]}"; do
  [[ -e "$REPO_ROOT/$f" ]] || continue
  is_excluded "$f" && continue
  ALL_FILES+=("$f")
  case "$f" in
  *.sh | *.bash) SH_FILES+=("$f") ;;
  *.yaml | *.yml) YAML_FILES+=("$f") ;;
  *.md) MD_FILES+=("$f") ;;
  esac
done

if [[ ${#ALL_FILES[@]} -eq 0 ]]; then
  log "all staged files excluded; nothing to check"
  exit 0
fi

# --- Shell ----------------------------------------------------------------

if [[ ${#SH_FILES[@]} -gt 0 ]] && require_tool shellcheck shell; then
  log "shellcheck: ${#SH_FILES[@]} file(s)"
  shellcheck "${SH_FILES[@]}"
fi

if [[ ${#SH_FILES[@]} -gt 0 ]] && require_tool shfmt shell; then
  log "shfmt: ${#SH_FILES[@]} file(s)"
  # -i 0: use 2 spaces for indentation
  # -d: diff only (don't modify the file).
  shfmt -i 2 -d "${SH_FILES[@]}"
fi

# --- YAML -----------------------------------------------------------------

if [[ ${#YAML_FILES[@]} -gt 0 ]] && require_tool yamllint yaml; then
  log "yamllint: ${#YAML_FILES[@]} file(s)"
  # Auto-discover `.yamllint.yml` at the repo root; do NOT pass -d
  # inline or the config file is ignored.
  yamllint "${YAML_FILES[@]}"
fi

# --- Markdown (Obsidian-flavored) -----------------------------------------
#
# markdownlint-cli2 surfaces Obsidian-vault content issues that aren't
# strictly bugs (frontmatter style, heading/list spacing, table column
# counts in generated content). They're reported as a "Finding:" summary
# followed by per-rule violations; per the user's standing direction,
# surface them but don't gate the commit on them.
#
if [[ ${#MD_FILES[@]} -gt 0 ]] && require_tool markdownlint-cli2 markdown; then
  log "markdownlint-cli2: ${#MD_FILES[@]} file(s)"
  markdownlint-cli2 --no-globs --config .markdownlint-cli2.jsonc "${MD_FILES[@]}" || true
fi

# --- Secret scan (always run) ---------------------------------------------

if [[ ${#ALL_FILES[@]} -gt 0 ]] && require_tool betterleaks secrets; then
  log "betterleaks: scanning ${#ALL_FILES[@]} file(s)"
  betterleaks protect --staged --no-banner "${ALL_FILES[@]}"
fi

log "all checks passed"
